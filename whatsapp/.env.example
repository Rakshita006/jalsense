# ──────────────────────────────────────────────────────────────
#  JalSense — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit the actual .env file to version control.
# ──────────────────────────────────────────────────────────────

# ── Twilio Credentials ────────────────────────────────────────
# Found at: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# The WhatsApp-enabled number in E.164 format (Twilio sandbox or production)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Webhook ───────────────────────────────────────────────────
# Full public URL of this service (used for Twilio signature validation).
# For local dev, use your ngrok URL, e.g.: https://abc123.ngrok.io
WEBHOOK_BASE_URL=https://abc123.ngrok.io

# Set to "false" in production; "true" allows local testing without
# a valid Twilio signature.
TWILIO_SKIP_SIGNATURE_VALIDATION=true

# ── Real Analysis API (teammate's backend) ────────────────────
# Used when you swap mock_analysis.py for the real API call.
# Leave as-is for now; it is not called during mock mode.
ANALYSIS_API_URL=http://localhost:8080/api/analyze
ANALYSIS_API_TIMEOUT_SECONDS=10

# ── Application ───────────────────────────────────────────────
LOG_LEVEL=INFO
APP_PORT=8000

# ── AI4Bharat TTS (Hindi voice alerts) ───────────────────────
# HuggingFace auth token — only required if the model is gated.
# Leave blank if the model is publicly accessible (current default).
HF_TOKEN=

# HuggingFace model ID for Indic Parler-TTS
TTS_MODEL_ID=ai4bharat/indic-parler-tts

# Directory where generated WAV files are saved
TTS_AUDIO_DIR=generated_audio

# Set to "false" to skip TTS loading entirely (useful for fast unit tests)
TTS_ENABLED=true
